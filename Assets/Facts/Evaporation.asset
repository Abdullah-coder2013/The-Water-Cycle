  m_Script: {fileID: 11500000, guid: e67cd6817dcb29f468d27d58fdd355ca, type: 3}
  m_Name: Evaporation
  m_EditorClassIdentifier: 
  stage: 5
  stageName: Evaporation
  facts:
  - factText: Evaporation is when the water on the surface of a water body gets vaporised
      by the sun and rises in a gas form.
    narrationClip: {fileID: 0}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: These water molecules float very high until they reach a cold point.
    narrationClip: {fileID: 0}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: 'At the cold point, the next step starts to happen: Condensation'
    narrationClip: {fileID: 0}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: Before we get to the final point, I want to share another piece of
      information.
    narrationClip: {fileID: 0}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: If the water molecule collides with SO2 or NOx, the chemicals for acid
      rain, it becomes acidic.
    narrationClip: {fileID: 0}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: Now, onto the last step, Condensation.
    narrationClip: {fileID: 0}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  defaultFactDuration: 5
  timeBetweenFacts: 1
