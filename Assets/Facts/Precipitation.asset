  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e67cd6817dcb29f468d27d58fdd355ca, type: 3}
  m_Name: Precipitation
  m_EditorClassIdentifier: 
  stage: 1
  stageName: Precipitation
  facts:
  - factText: Precipitation happens when water droplets in clouds become too heavy
      to stay in the air and fall to the ground.
    narrationClip: {fileID: 8300000, guid: d7ba8610bb456fe42b346e6f42744450, type: 3}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: It can fall as rain, snow, sleet, or hail, depending on the temperature
      in the atmosphere.
    narrationClip: {fileID: 8300000, guid: 5ce318105f42b674aa05e9a90ce43b46, type: 3}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: Snow forms when water vapor freezes directly into ice crystals inside
      cold clouds.
    narrationClip: {fileID: 8300000, guid: 01edd2391a76fb8409f5c4241f090d79, type: 3}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: Hail forms during strong thunderstorms, where updrafts carry water
      droplets high into freezing air, adding layers of ice before falling to the
      ground.
    narrationClip: {fileID: 8300000, guid: 5275b896cdfdfa64b96b37feb22e11af, type: 3}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: "Sometimes, air pollution mixes with precipitation, creating acid rain\u2014a
      more acidic form of rainfall that can damage forests, lakes, soil, and even
      buildings."
    narrationClip: {fileID: 8300000, guid: c98610e2267cb404f8f90034d71d548a, type: 3}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: "From the sky to the surface\u2014onto the next stage: Drainage."
    narrationClip: {fileID: 8300000, guid: 250774a4cbb73b240b340e1db0409a72, type: 3}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  defaultFactDuration: 5
  timeBetweenFacts: 2
