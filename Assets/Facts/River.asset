  m_Script: {fileID: 11500000, guid: e67cd6817dcb29f468d27d58fdd355ca, type: 3}
  m_Name: River
  m_EditorClassIdentifier: 
  stage: 3
  stageName: River
  facts:
  - factText: Rivers collect water from rainfall, snowmelt, springs, and glacier
      melt, carrying it from higher elevations to lower ones, eventually reaching
      lakes, seas, or oceans.
    narrationClip: {fileID: 8300000, guid: b655710b6da7db641b49d18dfaaae9bd, type: 3}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: Rivers shape the land over time through erosion and support life all
      along their paths.
    narrationClip: {fileID: 8300000, guid: 7bb82257abb5a8b42a1ca58181f25e92, type: 3}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: They are essential for ecosystems, drinking water, agriculture, and
      transportation.
    narrationClip: {fileID: 8300000, guid: 47516dc329458684fb08cd673da469e4, type: 3}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: "The current keeps moving\u2014time for the next stage: Ocean."
    narrationClip: {fileID: 8300000, guid: 92e33a258a16d4140a2f2bbaec03156b, type: 3}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  defaultFactDuration: 5
  timeBetweenFacts: 1
