  m_Script: {fileID: 11500000, guid: e67cd6817dcb29f468d27d58fdd355ca, type: 3}
  m_Name: CityDrainage
  m_EditorClassIdentifier: 
  stage: 2
  stageName: CityDrainage
  facts:
  - factText: 'In cities and towns, rainwater often flows over roads and rooftops
      into storm drains and sewer systems. '
    narrationClip: {fileID: 8300000, guid: c923a9a6239fc03448241a240d849f4d, type: 3}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: These pipes prevent flooding and can lead to treatment plants or nearby
      rivers and oceans.
    narrationClip: {fileID: 8300000, guid: 36ada79f7ac5024439bafe73a539a4fe, type: 3}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: However, urban runoff can carry pollutants with it.
    narrationClip: {fileID: 8300000, guid: 7d9f5aba6651679449311d9879770d38, type: 3}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: "Water finds its way\u2014now flowing toward the next stage: River."
    narrationClip: {fileID: 8300000, guid: 2245e542265232f4e86d685e4ab4b5d4, type: 3}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  defaultFactDuration: 5
  timeBetweenFacts: 1
