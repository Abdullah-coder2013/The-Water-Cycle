  m_Script: {fileID: 11500000, guid: e67cd6817dcb29f468d27d58fdd355ca, type: 3}
  m_Name: Condensation
  m_EditorClassIdentifier: 
  stage: 6
  stageName: Condensation
  facts:
  - factText: As water vapor rises into the atmosphere, it cools and condenses into
      tiny water droplets.
    narrationClip: {fileID: 8300000, guid: 47276a08ce1b2404e9d4cdcf8d1eaeea, type: 3}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: These droplets group together to form clouds or fog.
    narrationClip: {fileID: 8300000, guid: 235d51e58db5bff4eb43c97481fb2c3e, type: 3}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: Condensation is the reverse of evaporation.
    narrationClip: {fileID: 8300000, guid: c96eae4b61ae1524fbc54c4e0dee4a4e, type: 3}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: "Once enough droplets gather and become heavy, they fall back to Earth
      as precipitation\u2014restarting the cycle again."
    narrationClip: {fileID: 8300000, guid: 4a4fb331920acb541b2394cb5a8c892b, type: 3}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: "And just like that, the loop continues\u2014back to Precipitation!"
    narrationClip: {fileID: 8300000, guid: 642171cf148c83d478130b30463c5b02, type: 3}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  defaultFactDuration: 5
  timeBetweenFacts: 1
