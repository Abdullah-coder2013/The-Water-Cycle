  m_Script: {fileID: 11500000, guid: e67cd6817dcb29f468d27d58fdd355ca, type: 3}
  m_Name: Condensation
  m_EditorClassIdentifier: 
  stage: 6
  stageName: Condensation
  facts:
  - factText: 'This is the last step before we start again. '
    narrationClip: {fileID: 0}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: The water molecule rises so high, that it collides with the other molecules
      to build clouds.
    narrationClip: {fileID: 0}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: These clouds then stay in the sky until their water mollecules collide
      so much and and get so heavy, that they cannot float anymore.
    narrationClip: {fileID: 0}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: 'This is the end of the cycle. This whole thing starts again. '
    narrationClip: {fileID: 0}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: From Precipitation,
    narrationClip: {fileID: 0}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: To Drainage,
    narrationClip: {fileID: 0}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: To the River,
    narrationClip: {fileID: 0}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: To the Ocean
    narrationClip: {fileID: 0}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: Then Evaporation,
    narrationClip: {fileID: 0}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: To finally, Condensation.
    narrationClip: {fileID: 0}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: This loop has been going on for millions of years.
    narrationClip: {fileID: 0}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: All of the water in this earth is all it has ever been.
    narrationClip: {fileID: 0}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: If you think about it, we don't have new sources of water coming to
      earth.
    narrationClip: {fileID: 0}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: Now,
    narrationClip: {fileID: 0}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: It's time.
    narrationClip: {fileID: 0}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: 'for Step 1: Precipitation once again!'
    narrationClip: {fileID: 0}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  - factText: An infinite LOOP
    narrationClip: {fileID: 0}
    displayDuration: 0
    waitForAudio: 1
    delayBeforeShow: 0
  defaultFactDuration: 5
  timeBetweenFacts: 1
